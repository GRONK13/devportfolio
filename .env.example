# Copy to .env.local for local development. Never commit real values.

# Public URL of the deployed site (used for canonical links, sitemap and Open Graph).
# Optional on Vercel, which provides VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://greggmarayan.me

# Contact form (https://resend.com). Without a key, submissions are logged in
# development and the form asks visitors to email directly in production.
RESEND_API_KEY=
# Inbox that receives contact form messages.
CONTACT_TO_EMAIL=gregg.marayan@gmail.com
# Verified sender, e.g. "Portfolio <hello@greggmarayan.me>". Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=

# Optional: a GitHub token with NO scopes (read-only public data) raises the
# API rate limit for the GitHub activity tile. Works without it.
GITHUB_TOKEN=
