# Copy to .env.local for local development. Never commit real values.
# On Vercel, mark every secret as "Sensitive".

# Public URL of the deployed site (canonical links, sitemap, Open Graph).
# Optional on Vercel, which provides VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://greggmarayan.me

# Contact form (https://resend.com). Use a key restricted to "Sending access" for one domain.
# Without a key, development skips sending and production asks visitors to email directly.
# Note: with a key set, `pnpm dev` sends real email.
RESEND_API_KEY=
# Inbox that receives messages. Defaults to the email in content/profile.yaml.
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Portfolio <hello@greggmarayan.me>". Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=
